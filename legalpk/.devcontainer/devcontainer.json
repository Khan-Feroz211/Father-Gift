{
  "name": "LegalPakistan Dev",
  "dockerComposeFile": "../docker-compose.codespace.yml",
  "service": "app",
  "workspaceFolder": "/workspace/legalpk",
  "forwardPorts": [3001, 8000, 5432, 6379, 5555],
  "portsAttributes": {
    "3001": {
      "label": "Frontend (React)",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5555": {
      "label": "Celery Flower",
      "onAutoForward": "notify"
    },
    "5432": {
      "onAutoForward": "silent"
    },
    "6379": {
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-services.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "humao.rest-client",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "ckolkman.vscode-postgres"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/legalpk/backend/.venv/bin/python",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "tailwindCSS.experimental.classRegex": [
          ["cn\\(([^)]*)\\)", "\"([^\"]*)\""]
        ]
      }
    }
  }
}
