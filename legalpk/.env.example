# Application
APP_NAME=LegalPakistan
APP_ENV=development
APP_SECRET_KEY=changeme-super-secret-key-replace-in-production
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://legalpk:legalpk@localhost:5432/legalpk
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# JWT Authentication
JWT_SECRET_KEY=changeme-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# FAISS Vector Search
FAISS_INDEX_PATH=backend/data/faiss/cases.index
FAISS_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
FAISS_TOP_K=10

# File Storage
UPLOAD_DIR=backend/data/uploads
GENERATED_DOCS_DIR=backend/data/generated
MAX_UPLOAD_SIZE_MB=10

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@legalpakistan.com

# CORS
ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.railway.app

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry
SENTRY_DSN=
